# ==========================================
# Environment Configuration (.env.example)
# Copy this file to backend/.env and populate with your credentials.
# ==========================================

# General Application Settings
ENVIRONMENT=development
PROJECT_NAME="Multi-Candidate Semantic Talent Engine"
API_V1_PREFIX=/api/v1
DEBUG=True

# Database Configuration (PostgreSQL 16 + pgvector)
# Format for asyncpg: postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
# For Supabase connection pooler: postgresql+asyncpg://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/talent_engine
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Google Gemini AI Platform
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=text-embedding-004
COMPLETION_MODEL=gemini-2.5-flash

# Security & CORS
# Comma-separated list of allowed origins for Next.js frontend
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Storage Settings
STORAGE_LOCAL_DIR=./storage/resumes
MAX_UPLOAD_SIZE_MB=25

# pgvector Search Tuning Parameters
HNSW_EF_SEARCH=40
CHUNK_SIMILARITY_THRESHOLD=0.35
MAX_CHUNKS_PER_CANDIDATE=3
